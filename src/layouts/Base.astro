---
import '@fontsource-variable/inter-tight';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Loader from '../components/Loader.astro';
import Curtain from '../components/Curtain.astro';
import Cursor from '../components/Cursor.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { href } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}
const {
  title,
  description = 'Cichlid — computing at ANU, building game AI and exploring quantitative systems and visual interaction.',
} = Astro.props;
const fullTitle = title ? `${title} — Cichlid` : 'Cichlid — Code, Play, Create';
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFE600" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <script is:inline>
      // Apply stored preferences before first paint (mirrors scripts/prefs.ts).
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        try {
          const t = localStorage.getItem('cichlid:theme');
          const l = localStorage.getItem('cichlid:lang');
          if (t ? t === 'inv' : matchMedia('(prefers-color-scheme: dark)').matches) d.dataset.theme = 'inv';
          if (l ? l === 'zh' : navigator.language.startsWith('zh')) d.lang = 'zh-CN';
          const p = sessionStorage.getItem('cichlid:palette');
          if (p && p !== 'citrus') d.dataset.palette = p;
        } catch (e) {}
      })();
    </script>
    <ClientRouter fallback="none" />
  </head>
  <body>
    <Loader />
    <Curtain />
    <Cursor />
    <Header />
    <div class="page" id="page">
      <main id="main"><slot /></main>
      <Footer />
    </div>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
